# Copy the variables you need; never commit the real files (they are git-ignored).

# .env.development.local: loaded by `npm run dev` only, never by `npm run build`.
# An App Check debug token registered in the Firebase console (App Check > Apps > Manage debug tokens).
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# .env: used by data/seed.cjs and scripts/set-admin.cjs. Path to a service-account key kept outside the repo.
FIREBASE_ADMINSDK_SERVICE_ACCOUNT_PATH=
